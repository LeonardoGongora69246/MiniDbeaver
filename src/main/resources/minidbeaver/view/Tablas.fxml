<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="minidbeaver.controller.TablasController"
      spacing="12"
      prefWidth="520"
      prefHeight="520"
      alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tablas disponibles"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="lstTablas"
              VBox.vgrow="ALWAYS"/>

    <ProgressIndicator fx:id="progress"
                       visible="false"
                       managed="false"/>

    <Label fx:id="lblEstado"
           text="Conectado. Cargando tablas..."
           wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnRefrescar"
                text="Refrescar"
                onAction="#onRefrescar"/>

        <Button fx:id="btnDescargar"
                text="Descargar"
                onAction="#onDescargar"
                defaultButton="true"/>
    </HBox>

</VBox>